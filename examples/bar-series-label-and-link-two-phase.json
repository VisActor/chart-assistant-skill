{
  "phase1Create": {
    "commonOption": {
      "elements": [
        {
          "id": "sales-chart",
          "type": "chart",
          "position": { "x": 0, "y": 0, "width": 640, "height": 360 },
          "options": {
            "chartType": "bar",
            "data": {
              "type": "standard",
              "value": {
                "columns": ["月份", "产品A", "产品B"],
                "rows": ["1月", "2月"],
                "data": [
                  { "月份": "1月", "产品A": 120, "产品B": 90 },
                  { "月份": "2月", "产品A": 140, "产品B": 110 }
                ]
              }
            },
            "config": {
              "mappingSpec": { "x": "月份", "y": ["产品A", "产品B"] },
              "barLink": { "enable": true }
            }
          }
        }
      ]
    }
  },
  "phase2AfterReadback": {
    "precondition": "示例假设 phase1 的 browserData/runtime readback 返回 id=series-runtime-id、specIndex=0；实际执行必须替换为真实值",
    "modelSpecPatch": {
      "id": "series-runtime-id",
      "specKey": "series",
      "specIndex": 0,
      "spec": { "seriesLabel": { "visible": true } }
    },
    "mergeRule": "按真实 identity 深合并到已有 modelSpec，保留 axes/title/legend/其他 series；不要替换整个数组。"
  },
  "note": "barLink 不依赖 model identity，可在 phase1 开启；seriesLabel 的 canonical path 是 modelSpec，因此通常需要 phase2。"
}
